# ---------------------------------------------------------------------------
# DeepFake Bulk Video Degradation Tool - configuration
#
# Everything is optional. The tool works with zero configuration.
# There is NO database, NO cloud service and NO external API in this project.
# ---------------------------------------------------------------------------

# Absolute path to the ffmpeg binary. Leave empty to resolve "ffmpeg" from PATH.
FFMPEG_PATH=

# Absolute path to the ffprobe binary. Leave empty to resolve "ffprobe" from PATH.
FFPROBE_PATH=

# Comma separated list of absolute paths the server is allowed to read/write.
# Leave empty to allow any folder the OS user can already access.
# Example (Windows): D:\Deepfake,E:\Datasets
# Example (Linux/macOS): /data/deepfake,/mnt/datasets
ALLOWED_ROOTS=

# Port used by `npm run dev` / `npm start` (also change the scripts in package.json).
PORT=4321
